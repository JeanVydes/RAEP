 "scenarios": [
  {
   "id": "C-013",
   "title": "Cancel after the turn finished returns TURN_NOT_ACTIVE",
   "profile": "Core",
   "requires": [],
   "setup": {
    "agent": {
     "id": "test-agent",
     "tools": {
      "builtin": [
       "echo"
      ]
     }
    },
    "provider_script": [
     {
      "output": "done"
     }
    ]
   },
   "steps": [
    {
     "send": {
      "type": "SESSION_ATTACH",
      "session_id": "",
      "payload": {
       "agent_id": "test-agent"
      }
     }
    },
    {
     "expect": {
      "type": "HELLO"
     }
    },
    {
     "expect": {
      "type": "SESSION_ATTACHED",
      "payload": {
       "created": true
      }
     }
    },
    {
     "expect": {
      "type": "SESSION_STATE"
     }
    },
    {
     "send": {
      "type": "USER_INPUT",
      "turn_id": "t1",
      "payload": {
       "prompt": "hi"
      }
     }
    },
    {
     "expect": {
      "type": "TURN_STATE_CHANGED",
      "payload": {
       "state": "COMPLETED"
      },
      "envelope": {
       "turn_id": "t1"
      }
     }
    },
    {
     "send": {
      "type": "CANCEL_TURN",
      "turn_id": "t1",
      "payload": {}
     }
    },
    {
     "expect": {
      "type": "ERROR",
      "payload": {
       "code": "TURN_NOT_ACTIVE"
      }
     }
    },
    {
     "expect_none": {
      "type": "TURN_STATE_CHANGED",
      "within_ms": 500
     }
    }
   ]
  },
  {
   "id": "C-041",
   "title": "Resume replays exactly the missed events",
   "profile": "Resilient",
   "requires": [
    "resume"
   ],
   "setup": {
    "agent": {
     "id": "test-agent",
     "tools": {
      "builtin": [
       "echo"
      ]
     }
    },
    "provider_script": [
     {
      "output": "one two three"
     }
    ]
   },
   "steps": [
    {
     "send": {
      "type": "SESSION_ATTACH",
      "session_id": "",
      "payload": {
       "agent_id": "test-agent"
      }
     }
    },
    {
     "expect": {
      "type": "SESSION_ATTACHED",
      "envelope": {
       "seq": {
        "$capture": "attached_seq"
       }
      }
     }
    },
    {
     "expect": {
      "type": "SESSION_STATE"
     }
    },
    {
     "send": {
      "type": "USER_INPUT",
      "turn_id": "t1",
      "payload": {
       "prompt": "go"
      }
     }
    },
    {
     "expect": {
      "type": "TOKEN_DELTA",
      "envelope": {
       "seq": {
        "$capture": "last_seen"
       }
      }
     }
    },
    {
     "action": {
      "name": "disconnect"
     }
    },
    {
     "action": {
      "name": "reconnect"
     }
    },
    {
     "send": {
      "type": "SESSION_ATTACH",
      "payload": {
       "agent_id": "test-agent",
       "resume_from_seq": {
        "$use": "last_seen"
       }
      }
     }
    },
    {
     "expect": {
      "type": "SESSION_ATTACHED",
      "payload": {
       "replay": {
        "truncated": false
       }
      }
     }
    },
    {
     "expect": {
      "type": "TURN_STATE_CHANGED",
      "payload": {
       "state": "COMPLETED"
      }
     }
    }
   ]
  },
  {
   "id": "C-043",
   "title": "Crash: lost range, interrupted turn, interrupted tool call",
   "profile": "Resilient",
   "requires": [
    "resume",
    "jobs"
   ],
   "setup": {
    "agent": {
     "id": "test-agent",
     "tools": {
      "builtin": [
       "echo"
      ]
     }
    },
    "provider_script": [
     {
      "tool_call": {
       "name": "echo",
       "arguments": {
        "text": "x"
       },
       "hang": true
      }
     }
    ]
   },
   "steps": [
    {
     "send": {
      "type": "SESSION_ATTACH",
      "session_id": "",
      "payload": {
       "agent_id": "test-agent"
      }
     }
    },
    {
     "expect": {
      "type": "SESSION_ATTACHED"
     }
    },
    {
     "expect": {
      "type": "SESSION_STATE"
     }
    },
    {
     "send": {
      "type": "USER_INPUT",
      "turn_id": "t1",
      "payload": {
       "prompt": "go"
      }
     }
    },
    {
     "expect": {
      "type": "TOOL_CALL_STARTED",
      "payload": {
       "tool_name": "echo"
      }
     }
    },
    {
     "action": {
      "name": "crash_server"
     }
    },
    {
     "action": {
      "name": "reconnect"
     }
    },
    {
     "send": {
      "type": "SESSION_ATTACH",
      "payload": {
       "agent_id": "test-agent",
       "resume_from_seq": 3
      }
     }
    },
    {
     "expect": {
      "type": "SESSION_ATTACHED",
      "payload": {
       "replay": {
        "lost": {
         "from_seq": {
          "$exists": true
         }
        }
       }
      }
     }
    },
    {
     "expect": {
      "type": "TOOL_CALL_FINISHED",
      "payload": {
       "status": "ERROR",
       "result_summary": "interrupted"
      }
     }
    },
    {
     "expect": {
      "type": "TURN_STATE_CHANGED",
      "payload": {
       "state": "FAILED",
       "error": {
        "code": "INTERNAL",
        "details": {
         "reason": "interrupted"
        }
       }
      }
     }
    }
   ]
  },
  {
   "id": "C-130",
   "title": "Client-side tool: request, result, finish",
   "profile": "Client tools",
   "requires": [
    "client_tools"
   ],
   "setup": {
    "agent": {
     "id": "test-agent",
     "tools": {
      "client": true
     }
    },
    "provider_script": [
     {
      "tool_call": {
       "name": "read_file",
       "arguments": {
        "path": "a.txt"
       }
      }
     },
     {
      "output": "ok"
     }
    ]
   },
   "steps": [
    {
     "send": {
      "type": "SESSION_ATTACH",
      "session_id": "",
      "payload": {
       "agent_id": "test-agent",
       "capabilities": {
        "client_tools": [
         {
          "name": "read_file",
          "input_schema": {
           "type": "object"
          },
          "executor": "client"
         }
        ]
       }
      }
     }
    },
    {
     "expect": {
      "type": "SESSION_ATTACHED"
     }
    },
    {
     "expect": {
      "type": "SESSION_STATE"
     }
    },
    {
     "send": {
      "type": "USER_INPUT",
      "turn_id": "t1",
      "payload": {
       "prompt": "read it"
      }
     }
    },
    {
     "expect": {
      "type": "TOOL_CALL_STARTED",
      "payload": {
       "executor": "client"
      }
     }
    },
    {
     "expect": {
      "type": "CLIENT_TOOL_REQUEST",
      "payload": {
       "tool_name": "read_file",
       "tool_call_id": {
        "$capture": "call"
       }
      }
     }
    },
    {
     "send": {
      "type": "CLIENT_TOOL_RESULT",
      "turn_id": "t1",
      "payload": {
       "tool_call_id": {
        "$use": "call"
       },
       "status": "OK",
       "content": "hello"
      }
     }
    },
    {
     "expect": {
      "type": "TOOL_CALL_FINISHED",
      "payload": {
       "status": "OK"
      }
     }
    },
    {
     "expect": {
      "type": "TURN_STATE_CHANGED",
      "payload": {
       "state": "COMPLETED"
      }
     }
    }
   ]
  }
 ]
}